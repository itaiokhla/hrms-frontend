# The browser only talks to this Next.js app; /api/v1/* is proxied to FastAPI.
# Server-side only (not exposed to the browser):
BACKEND_URL=http://localhost:8000

# White label (optional). Must match the backend: the Next.js server sends the original
# Host to FastAPI with this secret; without it every request counts as the platform host.
# PROXY_SHARED_SECRET=
# Hostnames (no port) of the platform itself; the platform console exists only there.
# PLATFORM_HOSTS=localhost,127.0.0.1
